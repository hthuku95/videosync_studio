{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/delivery/:id",
      "destination": "https://videosync.ink/delivery/:id"
    },
    {
      "source": "/delivery/:id/stream",
      "destination": "https://videosync.ink/delivery/:id/stream"
    },
    {
      "source": "/delivery/:id/clip/:idx",
      "destination": "https://videosync.ink/delivery/:id/clip/:idx"
    },
    {
      "source": "/delivery/:id/feedback",
      "destination": "https://videosync.ink/delivery/:id/feedback"
    },
    {
      "source": "/delivery/:path*",
      "destination": "https://videosync.ink/delivery/:path*"
    }
  ]
}
